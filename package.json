{
  "name": "spotriq",
  "private": true,
  "version": "0.39.0",
  "packageManager": "pnpm@10.14.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @spotriq/web --filter @spotriq/api --filter @spotriq/worker dev",
    "dev:web": "pnpm --filter @spotriq/web dev",
    "dev:api": "pnpm --filter @spotriq/api dev",
    "dev:worker": "pnpm --filter @spotriq/worker dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r build",
    "check": "pnpm verify && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @spotriq/db migrate",
    "db:health": "pnpm --filter @spotriq/db health",
    "verify": "node scripts/verify-foundation.mjs",
    "verify:reference-acceptance": "node scripts/verify-reference-acceptance.mjs",
    "verify:commercial-acceptance": "node scripts/verify-commercial-acceptance.mjs",
    "verify:activation-parity": "node scripts/verify-activation-parity.mjs",
    "verify:permission-checkout": "node scripts/verify-permission-checkout.mjs",
    "verify:execution-adapter-parity": "node scripts/verify-execution-adapter-parity.mjs",
    "verify:activity-outcome-parity": "node scripts/verify-activity-outcome-parity.mjs",
    "verify:my-agents": "node scripts/verify-my-agents.mjs",
    "verify:smart-money-plans": "node scripts/verify-smart-money-plans.mjs",
    "verify:operator-workspace": "node scripts/verify-operator-workspace.mjs",
    "verify:paid-rails": "node scripts/verify-paid-rails.mjs",
    "verify:agent-studio": "node scripts/verify-agent-studio.mjs",
    "verify:grounded-explanations": "node scripts/verify-grounded-explanations.mjs",
    "verify:agent-advantage": "node scripts/verify-agent-advantage.mjs",
    "verify:observability": "node scripts/verify-observability.mjs",
    "verify:security-hardening": "node scripts/verify-security-hardening.mjs",
    "verify:production-hardening": "node scripts/verify-production-hardening.mjs",
    "verify:adoption-readiness": "node scripts/verify-adoption-readiness.mjs",
    "capture:public-launch-evidence": "node scripts/capture-public-launch-evidence.mjs",
    "verify:adoption-analytics": "node scripts/verify-adoption-analytics.mjs",
    "capture:adoption-baseline": "node scripts/capture-adoption-baseline.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.1",
    "typescript": "5.7.3"
  }
}
