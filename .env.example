# Spotriq environment
NODE_ENV=development
SPOTRIQ_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
PUBLIC_API_BASE_URL=http://127.0.0.1:3001
CORS_ORIGINS=http://localhost:5173

# Persistence (leave blank for local in-memory stores)
DATABASE_URL=
REDIS_URL=

# BSC runtime
BSC_NETWORK=testnet
BSC_RPC_PRIMARY=
BSC_RPC_SECONDARY=
BSC_RPC_TIMEOUT_MS=7500

# External ERC-8004 discovery defaults to BSC Mainnet
AGENT_DISCOVERY_CHAIN_ID=56
SCAN8004_BASE_URL=https://8004scan.io/api/v1/public
SCAN8004_API_KEY=
SCAN8004_TIMEOUT_MS=7500
AGENT_REGISTRY_MAINNET_RPC=
AGENT_REGISTRY_TESTNET_RPC=

# First-party reference-agent ERC-8004 reconciliation.
# Keep separate from AGENT_DISCOVERY_CHAIN_ID so external discovery can remain Mainnet
# while current first-party acceptance identities are verified on BSC Testnet.
REFERENCE_AGENT_REGISTRY_CHAIN_ID=97
REFERENCE_AGENT_RANGEKEEPER_ID=
REFERENCE_AGENT_GRIDPILOT_ID=
REFERENCE_AGENT_YIELDPILOT_ID=
REFERENCE_AGENT_VENUSGUARD_ID=

# Marketplace Test Lab
MARKETPLACE_TEST_TIMEOUT_MS=5000
MARKETPLACE_TEST_MAX_RESPONSE_BYTES=256000
MARKETPLACE_TEST_MAX_REDIRECTS=2

# AgentService task invocation
SERVICE_TASK_TIMEOUT_MS=10000
SERVICE_TASK_MAX_RESPONSE_BYTES=384000
SERVICE_TASK_MAX_REDIRECTS=2

# v0.33 Grounded AI explanations (optional external provider; deterministic fallback works without a key)
# OPENAI_API_KEY=sk-...
SPOTRIQ_EXPLANATION_MODEL=gpt-5.6-luna
SPOTRIQ_EXPLANATION_TIMEOUT_MS=12000

# v0.35 Operational observability
# Optional. Leave unset to keep admin diagnostics disabled/fail-closed.
SPOTRIQ_ADMIN_DIAGNOSTICS_TOKEN=
SPOTRIQ_OBSERVABILITY_TESTLAB_TARGET_AGE_SECONDS=21600
SPOTRIQ_OBSERVABILITY_TESTLAB_STALE_AFTER_SECONDS=86400
SPOTRIQ_OBSERVABILITY_WORKER_STALE_AFTER_SECONDS=90
SPOTRIQ_OBSERVABILITY_WORKER_UNAVAILABLE_AFTER_SECONDS=300

# v0.37 production hardening / scale tuning
SPOTRIQ_API_BODY_LIMIT_BYTES=1048576
SPOTRIQ_API_REQUEST_TIMEOUT_MS=30000
SPOTRIQ_API_CONNECTION_TIMEOUT_MS=10000
SPOTRIQ_TRUST_PROXY_HOPS=1
SPOTRIQ_RATE_LIMIT_ENABLED=true
SPOTRIQ_RATE_LIMIT_WINDOW_MS=60000
SPOTRIQ_RATE_LIMIT_READ_MAX=300
SPOTRIQ_RATE_LIMIT_WRITE_MAX=60
SPOTRIQ_DB_POOL_MAX=15
SPOTRIQ_DB_IDLE_TIMEOUT_MS=30000
SPOTRIQ_DB_CONNECTION_TIMEOUT_MS=5000
SPOTRIQ_DB_STATEMENT_TIMEOUT_MS=20000
SPOTRIQ_WORKER_POLL_INTERVAL_MS=2000
SPOTRIQ_WORKER_LEASE_MS=30000
