# Spotriq application environment
NODE_ENV=development
SPOTRIQ_ENV=development

# Marketplace API
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGINS=http://localhost:5173

# Database. Optional for local ephemeral mode; configure Railway PostgreSQL for durable Smart Money Check sessions/evidence/findings.
DATABASE_URL=

# Future worker/queue infrastructure
REDIS_URL=

# BSC chain data layer. In development, blank URLs use official public BSC fallback endpoints.
# For production/staging reliability, configure dedicated primary/secondary RPC endpoints.
BSC_NETWORK=testnet
BSC_RPC_PRIMARY=
BSC_RPC_SECONDARY=

# Frontend API origin
VITE_SPOTRIQ_API_URL=http://localhost:3001
# Optional RPC request timeout in milliseconds. Official public BSC fallbacks are used in development when URLs are blank.
BSC_RPC_TIMEOUT_MS=7500

# ERC-8004 / 8004scan marketplace discovery. Discovery defaults to BSC mainnet (56) even while transaction development remains on BSC Testnet.
AGENT_DISCOVERY_CHAIN_ID=56
SCAN8004_BASE_URL=https://8004scan.io/api/v1/public
# Optional: without a key, 8004scan anonymous public rate limits apply.
SCAN8004_API_KEY=
SCAN8004_TIMEOUT_MS=15000
# Optional dedicated RPCs for canonical ERC-8004 identity verification. Blank values use the BSC chain adapter public fallbacks.
AGENT_REGISTRY_MAINNET_RPC=
AGENT_REGISTRY_TESTNET_RPC=

# Marketplace Test Lab. Probes are HTTPS-only, bounded, and never invoke financial actions.
MARKETPLACE_TEST_TIMEOUT_MS=5000
MARKETPLACE_TEST_MAX_RESPONSE_BYTES=256000
MARKETPLACE_TEST_MAX_REDIRECTS=2

# Real AgentService task invocation. Uses the same SSRF-safe remote runtime policy as Test Lab,
# but this path performs an explicit A2A task/message operation after the service passes the required gates.
SERVICE_TASK_TIMEOUT_MS=10000
SERVICE_TASK_MAX_RESPONSE_BYTES=384000
SERVICE_TASK_MAX_REDIRECTS=2
